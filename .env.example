# Padlet developer settings에서 발급한 값입니다. 실제 키는 .env.local에만 저장하세요.
PADLET_API_KEY=
PADLET_BOARD_ID=

# 섹션을 사용하는 보드라면 선택적으로 설정하세요.
PADLET_SECTION_ID=

# Firebase 콘솔 > 프로젝트 설정 > 내 앱 > 웹 앱 구성 값입니다.
# Authentication에서 익명 로그인을, Realtime Database를 각각 활성화하세요.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
